# Modelo fictício. Preencher no Render; nunca copiar credenciais para o frontend.
ENVIRONMENT=production
AUTH_MODE=supabase
DATABASE_URL=postgresql+psycopg://ROLE:REPLACE@HOST:5432/postgres?sslmode=verify-full
PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
CORS_ORIGIN=https://YOUR-FRONTEND.example
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
ALLOWED_USER_IDS=["00000000-0000-0000-0000-000000000001"]
INVITATION_ADMIN_IDS=["00000000-0000-0000-0000-000000000001"]
SUPABASE_SERVICE_ROLE_KEY=
APP_PUBLIC_URL=https://YOUR-FRONTEND.example
ADMIN_DATABASE_URL=postgresql+psycopg://ACCESS_OPERATOR:REPLACE@HOST:5432/postgres?sslmode=verify-full
# Mesmo endpoint/banco de DATABASE_URL; outro login, sem privilégios financeiros ou DDL.
INVITATION_SMTP_MODE=builtin
INVITATION_EMAILS_PER_HOUR=2
INVITATION_MAX_SEND_ATTEMPTS=5
INVITATION_SEND_COOLDOWN_SECONDS=60
INVITATION_DAILY_LIMIT=50
INVITATION_PENDING_LIMIT=50
# Uvicorn: definir com os IPs/redes reais dos proxies confiáveis antes de habilitar solicitações públicas.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1,REDE_PROXY_CONFIRMADA
# Render: adicione o PEM oficial do projeto como Secret File supabase-ca.crt.
# MIGRATION_DATABASE_URL pertence apenas à sessão administrativa de migração.
# A URL acima e o UUID são placeholders, não valores para ativação.

# Fase 1.9.2: somente backend; habilitação manual após homologação do plano gratuito.
MARKET_DATA_ENABLED=false
EQUITY_HISTORY_ENABLED=false
# Fase 4.1: sem provedor validado, manter o histórico individual desligado.
INDIVIDUAL_EQUITY_HISTORY_ENABLED=false
BRAPI_TOKEN=
# Assistente v1.2 (opcional): manter vazio desabilita o endpoint.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Limites internos da Íris, sem alterar quotas da organização na Groq.
ASSISTANT_ADMIN_PER_MINUTE=10
ASSISTANT_ADMIN_PER_DAY=500
ASSISTANT_USER_PER_MINUTE=5
ASSISTANT_USER_PER_DAY=100
ASSISTANT_COOLDOWN_SECONDS=2
