# Modelo fictício. Preencher no Render; nunca copiar credenciais para o frontend.
ENVIRONMENT=production
AUTH_MODE=supabase
DATABASE_URL=postgresql+psycopg://ROLE:REPLACE@HOST:5432/postgres?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_ROLE:REPLACE@HOST:5432/postgres?sslmode=verify-full
CORS_ORIGIN=https://YOUR-FRONTEND.example
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
ALLOWED_USER_IDS=["00000000-0000-0000-0000-000000000001"]
# Instale o certificado raiz exigido pelo provedor e configure PGSSLROOTCERT.
# A URL acima e o UUID são placeholders, não valores para ativação.
