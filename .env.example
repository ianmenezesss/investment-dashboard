POSTGRES_DB=investment
POSTGRES_USER=investment
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://investment:change-this-local-password@localhost:5432/investment
API_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=http://localhost:5173
ENVIRONMENT=development
MARKET_DATA_ENABLED=false
EQUITY_HISTORY_ENABLED=false
# Fase 4.1: manter desligado até validar fonte, dados e licença.
INDIVIDUAL_EQUITY_HISTORY_ENABLED=false
BRAPI_TOKEN=
AUTH_MODE=local
# Configuração opt-in; não é necessária para continuar usando o token local.
SUPABASE_URL=
ALLOWED_USER_IDS=[]
# Convites: apenas backend. APP_PUBLIC_URL deve ser a mesma origem privada do CORS.
INVITATION_ADMIN_IDS=[]
SUPABASE_SERVICE_ROLE_KEY=
APP_PUBLIC_URL=
# Login PostgreSQL distinto, membro somente de investment_access_admin (migration 017).
ADMIN_DATABASE_URL=
# Só elevar a cota depois de configurar SMTP próprio e conferir a cota no Supabase.
INVITATION_SMTP_MODE=builtin
INVITATION_EMAILS_PER_HOUR=2
INVITATION_MAX_SEND_ATTEMPTS=5
INVITATION_SEND_COOLDOWN_SECONDS=60
INVITATION_DAILY_LIMIT=50
INVITATION_PENDING_LIMIT=50

# Íris: limites internos; as quotas reais da Groq continuam válidas.
ASSISTANT_ADMIN_PER_MINUTE=10
ASSISTANT_ADMIN_PER_DAY=500
ASSISTANT_USER_PER_MINUTE=5
ASSISTANT_USER_PER_DAY=100
ASSISTANT_COOLDOWN_SECONDS=2
