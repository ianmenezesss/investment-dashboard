# Apenas configurações públicas. Nunca colocar token ou senha em VITE_*.
VITE_PUBLIC_DEMO=false
VITE_APP_MODE=demo
VITE_AUTH_MODE=local
# Vazio: proxy Vite local. Produção é demo salvo VITE_APP_MODE=private explícito.
VITE_API_BASE_URL=
# Para login Supabase, use VITE_AUTH_MODE=supabase e os valores públicos abaixo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
